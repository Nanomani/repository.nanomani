	</addon>

	<addon id="script.arctic.zephyr.rounded.autocolors" name="Arctic: Zephyr - Rounded - Automatic Day and Night Colors" version="2.1.5" provider-name="semool">
		<requires>
			<import addon="xbmc.gui" version="5.17.0"/>
			<import addon="script.module.simplecache"/>
			<import addon="script.module.requests"/>
			<import addon="script.module.astral"/>
		</requires>
		<extension point="xbmc.python.script" library="script.py">
			<provides>executable</provides>
		</extension>
		<extension point="xbmc.service" library="service.py" start="startup"/>
		<extension point="xbmc.addon.metadata">
			<summary lang="fr_FR">Changement automatique de la couleur du thème entre Clair et Foncé en fonction de l'heure</summary>	
			<summary lang="en_GB">Automatic time controlled theme color change between Light and Dark</summary>
			<summary lang="de_DE">Automatischer Zeitgesteuerter Skin Farbwechsel zwischen Hell und Dunkel</summary>
			<platform>all</platform>
			<source>https://github.com/Nanomani/script.arctic.zephyr.rounded.autocolors</source>
			<license>GNU GENERAL PUBLIC LICENSE Version 2</license>
			<assets>
				<icon>icon.png</icon>
				<fanart>fanart.jpg</fanart>
			</assets>
		</extension>
	</addon>

	<addon id="script.module.astral" name="astral" version="3.2" provider-name="semool">
		<requires>
			<import addon="xbmc.python" version="3.0.0"/>
			<import addon="script.module.backports.zoneinfo"/>
		</requires>
		<extension point="xbmc.python.module" library="lib"/>
		<extension point="xbmc.addon.metadata">
			<summary lang="en_GB">Astral for Python</summary>
			<description lang="en_GB">Astral is a python package for calculating the times of various aspects of the sun and phases of the moon</description>
			<platform>all</platform>
			<license>MIT</license>
			<website>https://pypi.org/project/astral</website>
			<source>https://github.com/sffjunkie/astral</source>
			<assets>
				<icon>icon.png</icon>
			</assets>
		</extension>
	</addon>

