<?xml version="1.0" encoding="UTF-8"?>
<addons>
	<addon id="skin.arctic.zephyr.rounded" version="2.0.28" name="Arctic: Zephyr - Rounded" provider-name="jurialmunkey, beatmasterrs, nanomani">
		<requires>
			<import addon="xbmc.gui" version="5.18.0"/>
			<import addon="script.skinshortcuts" version="0.4.0"/>
			<import addon="script.skinvariables" version="2.1.9" />
			<import addon="script.texturemaker" version="0.2.9" />
			<import addon="plugin.video.themoviedb.helper" version="5.2.17~nexus" />
			<import addon="script.wikipedia" version="0.0.5" />
			<import addon="script.artistslideshow" version="3.3.5"/>
			<import addon="script.globalsearch" version="3.0.0"/>
